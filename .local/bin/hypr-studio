#!/usr/bin/env python3
"""Hypr Studio: visual editor for the Quickshell bar/widgets/panels and the Hyprland config.

Pages: Bar (drag & drop module layout), Widgets (templates), Panels (new popup/panel windows),
Code (editor with live reload + error console), Hyprland (live appearance sliders, keybinds, glass).
Everything writes plain files that Quickshell / Hyprland pick up on their own:
  ~/.config/quickshell/layout.json   bar layout + panel list (Quickshell hot-reloads it)
  ~/.config/quickshell/user/<name>/main.qml   user panels (canvas ones also keep user/<name>.panel.json)
  ~/.config/hypr/studio.lua          persisted Hyprland tweaks (loaded last by hyprland.lua)
"""
import json
import os
import re
import subprocess
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("GtkSource", "5")
from gi.repository import Gtk, Gdk, GLib, GObject, Gio, GtkSource

sys.path.insert(0, os.path.expanduser("~/.local/lib"))
from neonskin import Skin  # shared neon skin (same palette as the bar, kitty, hyprglass-gui)
import panelcanvas  # canvas editor for panels

HOME = os.path.expanduser("~")
QS = HOME + "/.config/quickshell"
HYPR = HOME + "/.config/hypr"
LAYOUT = QS + "/layout.json"
USER_DIR = QS + "/user"
STUDIO_LUA = HYPR + "/studio.lua"
STUDIO_JSON = HYPR + "/studio.json"

