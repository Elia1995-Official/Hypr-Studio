        ("noise_strength", "Noise grain", 0, 1, 0.01, "float"),
        ("glass_opacity", "Glass opacity", 0, 1, 0.01, "float"),
    ]),
    ("Edge & refraction", [
        ("edge_height", "Edge height (lens px)", 0, 100, 1, "float"),
        ("edge_thickness_px", "Edge thickness px", 0, 100, 1, "float"),
        ("edge_thickness", "Edge thickness (relative)", 0, 0.15, 0.005, "float"),
