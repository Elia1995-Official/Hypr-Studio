def load_user_presets():
    try:
        return json.load(open(PRESET_FILE))
    except (OSError, ValueError):
        return {}


def store_user_presets(d):
    json.dump(d, open(PRESET_FILE, "w"), indent=2)

# (key, label, min, max, step, kind) -- kind: float | int | angle
SECTIONS = [
    ("Blur & frost", [
        ("blur_strength", "Blur strength", 0, 6, 0.05, "float"),
        ("blur_iterations", "Blur iterations", 1, 5, 1, "int"),
        ("frost", "Frost", 0, 1, 0.01, "float"),
